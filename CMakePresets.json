{
    "version": 6,
    "cmakeMinimumRequired": {
	"major": 3,
	"minor": 20,
	"patch": 0
    },
    "configurePresets": [
	{
	    "name": "nsl_linux_debug_preset",
	    "generator": "Ninja",
	    "binaryDir": "${sourceDir}/Build/Linux/Debug",
	    "cacheVariables": {
		"CMAKE_CXX_COMPILER": "clang++",
		"CMAKE_BUILD_TYPE": "Debug",
		"CMAKE_INSTALL_PREFIX": "/usr/local",
		"CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/Lib",
		"CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/Lib"
	    }
	},

	{
		"name": "nsl_windows_debug_preset",
		"generator": "Ninja",
		"binaryDir": "${sourceDir}/Build/Windows/Debug",
		"cacheVariables": {
			"CMAKE_CXX_COMPILER": "clang++",
			"CMAKE_BUILD_TYPE": "Debug",
			"CMAKE_INSTALL_PREFIX": "C:/Program Files/nsl",
			"CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/Lib",
			"CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/Lib"
		}
	}
    ],



    "buildPresets": [
	{
	    "name": "nsl_linux_debug_build",
	    "configurePreset": "nsl_linux_debug_preset",
	    "condition": {
		"type": "equals",
		"lhs": "${hostSystemName}",
		"rhs": "Linux"
	    }
	},

	{
		"name": "nsl_windows_debug_build",
		"configurePreset": "nsl_windows_debug_preset",
		"condition": {
			"type": "equals",
			"lhs": "${hostSystemName}",
			"rhs": "Windows"
		}
	}
    ],

    
    "workflowPresets": [
	{
	    "name": "nsl_linux_debug",
	    "steps": [
		{"type": "configure", "name": "nsl_linux_debug_preset"},
		{"type": "build", "name": "nsl_linux_debug_build"}
	    ]
	},

	{
		"name": "nsl_windows_debug",
		"steps": [
			{"type": "configure", "name": "nsl_windows_debug_preset"},
			{"type": "build", "name": "nsl_windows_debug_build"}
		]
	}
    ]
}
